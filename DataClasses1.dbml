  </Table>
  <Table Name="dbo.requisitions" Member="requisitions">
    <Type Name="requisition">
      <Column Name="requisition_id" Type="System.Int32" DbType="Int NOT NULL IDENTITY" IsPrimaryKey="true" IsDbGenerated="true" CanBeNull="false" />
      <Column Name="staff_id" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Column Name="request_date" Type="System.DateTime" DbType="Date NOT NULL" CanBeNull="false" />
      <Column Name="department" Type="System.String" DbType="VarChar(100) NOT NULL" CanBeNull="false" />
